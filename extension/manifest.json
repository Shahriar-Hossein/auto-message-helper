{
  "manifest_version": 3,
  "name": "Teams Local Replies",
  "version": "0.2.10",
  "description": "Local-model replies for unread Teams direct chats and selected groups, with Banglish and media context.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Configure Teams Local Replies" },
  "content_scripts": [{
    "matches": ["https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://teams.live.com/*"],
    "js": ["core.js", "teams.js", "content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
